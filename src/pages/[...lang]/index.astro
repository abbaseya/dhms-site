---
import Page from '../../layouts/Page.astro';
import { localePath, localeStaticPaths, strings, type Locale } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const t = strings(locale);
const promises = [
  [t.home.promiseFree, t.home.promiseFreeText],
  [t.home.promiseLanguage, t.home.promiseLanguageText],
  [t.home.promisePlatform, t.home.promisePlatformText],
  [t.home.promiseSimple, t.home.promiseSimpleText],
];
---

<Page locale={locale} page="" title={t.meta.homeTitle} description={t.meta.homeDescription}>
  <section class="hero">
    <p class="eyebrow">{t.home.eyebrow}</p>
    <h1>{t.home.title}</h1>
    <p class="lede">{t.home.lede}</p>
    <p class="actions">
      <a class="button primary" href={localePath(locale, 'how-it-works')}>{t.home.ctaHow}</a>
      <a class="button" href={localePath(locale, 'status')}>{t.home.ctaStatus}</a>
    </p>
  </section>

  <section class="prose">
    <h2>{t.home.problemTitle}</h2>
    <p>{t.home.problem1}</p>
    <p>{t.home.problem2}</p>
    <h2>{t.home.ideaTitle}</h2>
    <p>{t.home.idea1}</p>
    <p>{t.home.idea2}</p>
    <h2>{t.home.whoTitle}</h2>
    <p>{t.home.who1}</p>
    <p>{t.home.who2}</p>
  </section>

  <section aria-labelledby="promise">
    <h2 id="promise" class="section-title">{t.home.promiseTitle}</h2>
    <ul class="cards">
      {promises.map(([title, text]) => (
        <li class="card">
          <h3>{title}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
  </section>
</Page>
